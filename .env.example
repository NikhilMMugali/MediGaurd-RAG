# Application
APP_NAME=MediGaurd RAG
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_DEBUG=true

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_ALGORITHM=HS256

# PostgreSQL
DATABASE_URL=postgresql+psycopg://medigaurd:medigaurd@localhost:5432/medigaurd

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medigaurd_knowledge
QDRANT_API_KEY=

# Embedding provider
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM provider (choose one: gemini | groq | openai)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-70b-versatile
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# File upload
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./data/uploads

# Synthea import
SYNTHEA_CSV_DIR=./data/synthea
