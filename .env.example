# Application
APP_NAME=MediGuard RAG
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_DEBUG=true

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_ALGORITHM=HS256

# PostgreSQL
DATABASE_URL=postgresql+psycopg://medigaurd:medigaurd@localhost:5432/medigaurd

# Qdrant — "local" needs no server process (qdrant-client embedded mode,
# stored at QDRANT_PATH); "server" connects to QDRANT_URL instead.
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mediguard_knowledge
QDRANT_API_KEY=

# Embedding provider
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=200

# LLM provider (choose one: gemini | groq | openai). With no key set below,
# queries fall back to a non-hallucinating extractive answer (top authorized
# chunk, verbatim, cited) instead of failing — see progress/DECISIONS.md.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-70b-versatile
LLM_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# RAG retrieval tuning
RAG_TOP_K=8
RAG_SCORE_THRESHOLD=0.0

# File upload
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./data/uploads

# Synthea import
SYNTHEA_CSV_DIR=./data/synthea
